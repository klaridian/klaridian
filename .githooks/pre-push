#!/usr/bin/env bash
# Mirrors .github/workflows/ci.yml so a broken push fails locally, not on GitHub.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail

echo "[pre-push] Running CLI build + real E2E tests (packages/cli)..."
(cd packages/cli && npm install --no-audit --no-fund && npm test)

echo "[pre-push] All checks passed."

echo "[pre-push] Checking CLI flags <-> docs sync (BLOCKING)..."
(cd packages/cli && npm run docs:check) || {
  echo "[pre-push] cli-reference.mdx is out of sync with the real CLI flags." >&2
  echo "[pre-push] Run: (cd packages/cli && npm run docs:gen), review the diff, and commit it." >&2
  exit 1
}

echo "[pre-push] Running Vale doc style check (Microsoft Writing Style Guide, non-blocking)..."
if command -v vale >/dev/null 2>&1; then
  VALE_STYLES_PATH="$(pwd)/.github/vale/styles" \
  vale README.md AGENTS.md PLAN.md ARCHITECTURE.md CONTRIBUTING.md SECURITY.md \
    CODE_OF_CONDUCT.md STYLE.md packages/site/content/docs || \
    echo "[pre-push] Vale reported style issues above -- see STYLE.md. Not blocking this push."
else
  echo "[pre-push] vale not installed locally (brew install vale) -- skipping; CI's docs-style job still runs it."
fi
