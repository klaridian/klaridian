{
  "openapi": "3.0.3",
  "info": { "title": "Dialect deltas", "version": "1.0.0" },
  "paths": {
    "/measurements": {
      "post": {
        "operationId": "createMeasurement",
        "summary": "Record a measurement",
        "description": "Exercises the draft-07 to 2020-12 deltas that OpenAPI 3.0 actually produces: boolean exclusiveMinimum/exclusiveMaximum paired with minimum/maximum.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "count": { "type": "integer", "minimum": 0, "exclusiveMinimum": true },
                  "ratio": { "type": "number", "maximum": 100, "exclusiveMaximum": true },
                  "inclusive": { "type": "integer", "minimum": 1, "exclusiveMinimum": false },
                  "label": { "type": "string", "nullable": true }
                },
                "required": ["count"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The recorded measurement.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "score": { "type": "number", "minimum": 0, "exclusiveMinimum": true }
                  },
                  "required": ["id"]
                }
              }
            }
          }
        }
      }
    }
  }
}
