{
  "openapi": "3.0.3",
  "info": {
    "title": "Bookstore API (klaridian annotated example)",
    "version": "1.0.0",
    "description": "A small, self-contained OpenAPI spec that demonstrates klaridian's `x-klaridian` annotation extension: per-operation MCP tool hints (readOnly / destructive / openWorld) and hiding an operation from the tool surface with `expose: false`. See docs/how-to/curation for how these are used."
  },
  "servers": [{ "url": "https://api.bookstore.example.com" }],
  "tags": [
    { "name": "books", "description": "Browse and manage books" },
    { "name": "admin", "description": "Administrative operations" }
  ],
  "paths": {
    "/books": {
      "get": {
        "operationId": "listBooks",
        "summary": "List books",
        "tags": ["books"],
        "description": "Returns a page of books. A safe, read-only listing.",
        "x-klaridian": { "readOnly": true },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Full-text search over title and author.",
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Page size (default 20).",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": { "200": { "description": "A page of books." } }
      },
      "post": {
        "operationId": "createBook",
        "summary": "Add a book",
        "tags": ["books"],
        "description": "Creates a new book. A write that is not destructive.",
        "x-klaridian": { "readOnly": false, "destructive": false },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "author"],
                "properties": {
                  "title": { "type": "string" },
                  "author": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "The created book." } }
      }
    },
    "/books/{id}": {
      "get": {
        "operationId": "getBook",
        "summary": "Get a book",
        "tags": ["books"],
        "description": "Fetches a single book by ID.",
        "x-klaridian": { "readOnly": true },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "The book." } }
      },
      "delete": {
        "operationId": "deleteBook",
        "summary": "Delete a book",
        "tags": ["books"],
        "description": "Permanently removes a book. Explicitly marked destructive so the agent warns before calling it. `title` overrides the summary for the tool's display name.",
        "x-klaridian": { "destructive": true, "title": "Remove a book from the catalog" },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "204": { "description": "Deleted." } }
      }
    },
    "/admin/reindex": {
      "post": {
        "operationId": "reindexCatalog",
        "summary": "Rebuild the search index",
        "tags": ["admin"],
        "description": "An internal maintenance operation the author does not want exposed as an MCP tool. `expose: false` keeps it out of the generated tool surface entirely.",
        "x-klaridian": { "expose": false },
        "responses": { "202": { "description": "Reindex started." } }
      }
    }
  }
}
