{
  "name": "klaridian",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Generate MCP servers with built-in observability from an OpenAPI spec.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "code-generator",
    "opentelemetry",
    "observability",
    "posthog",
    "cli",
    "ai-agents"
  ],
  "homepage": "https://klaridian.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardocvasconcelos/klaridian.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ricardocvasconcelos/klaridian/issues"
  },
  "author": "Ricardo Vasconcelos",
  "type": "module",
  "bin": {
    "klaridian": "dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=4 dist/test/*.test.js",
    "docs:gen": "npm run build --silent && node scripts/generate-cli-docs.mjs",
    "docs:check": "npm run docs:gen --silent && git diff --exit-code -- ../site/content/docs/reference/cli-reference.mdx",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@amplitude/analytics-node": "^1.5.71",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@inquirer/prompts": "^8.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "jose": "^6.2.10",
    "json-schema-to-zod": "^2.8.1",
    "mixpanel": "^0.23.0",
    "openapi-mcp-generator": "4.0.1",
    "openapi-types": "^12.1.3",
    "posthog-node": "^5.21.2",
    "swagger2openapi": "^7.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/swagger2openapi": "^7.0.4",
    "typescript": "^5.7.3"
  }
}
